{
  "name": "knowembed",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:gh-pages": "GITHUB_PAGES=true npm run build",
    "build:android": "CAPACITOR=true tsc --noEmit && vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:release": "npm run build:android && npm run android:apk && node scripts/copy-apk.mjs",
    "screenshots:og": "node scripts/capture-og-image.mjs",
    "screenshots:app": "CAPTURE_APP_SCREENSHOT=1 npx playwright test capture-app-screenshot",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "screenshots": "CAPTURE_SCREENSHOTS=1 playwright test capture-guide-screenshots",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.110.9",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.0.9"
  }
}
